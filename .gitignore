# Working data
.daisy-data/

# Editor / OS
.DS_Store
.idea/
.vscode/

# Rust
/target/
**/*.rs.bk
# Cargo.lock is committed.

# Fixture cache (the .wav files are committed)
crates/audio-engine/tests/fixtures/.cache/

# Embedding model and tokenizer, fetched by scripts/download-embeddings.sh
/models/embeddings/

# WeSpeaker voiceprint model, fetched by scripts/download-voiceprints.sh
/models/voiceprints/*
!/models/voiceprints/download.ps1

# Local model files
/models/whisper/
/models/nemotron/
/models/nemotron3-diar/
/models/vad/

**/package.json.new

# Per-package node_modules
**/node_modules/
/dist/
.pnpm-store/

# daisy-llm sidecar, staged by scripts/stage-daisy-llm.{sh,ps1}
/crates/tauri-app/binaries/

# TypeScript incremental-build cache
apps/frontend/*.tsbuildinfo
crates/tauri-app/sessions/

# Vite cache
.vite/

# Tauri ACL schemas, regenerated by tauri-build
crates/tauri-app/gen/schemas/

# WebdriverIO e2e run artifacts (logs, failure screenshots)
apps/frontend/e2e/.artifacts/

