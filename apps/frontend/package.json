{
  "name": "daisy-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:webkit": "node test/webkit-layout.mjs",
    "test:contrast": "node test/contrast.mjs",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json",
    "e2e:native": "wdio run e2e/wdio.native.conf.ts",
    "e2e:native:spec": "wdio run e2e/wdio.native.conf.ts --spec",
    "e2e:browser": "wdio run e2e/wdio.browser.conf.ts",
    "e2e:browser:spec": "wdio run e2e/wdio.browser.conf.ts --spec",
    "capture:review": "node test/capture-review.mjs",
    "annotate:candidates": "node test/annotate-candidates.mjs",
    "publish:gallery": "node test/publish-gallery.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tiptap/pm": "^3.26.1",
    "@tiptap/react": "^3.26.1",
    "@tiptap/starter-kit": "^3.26.1",
    "qrcode": "^1.5.4",
    "react": "^18",
    "react-dom": "^18",
    "tiptap-markdown": "^0.9.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@types/node": "^26.1.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4",
    "@wdio/cli": "^9.31.4",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.31.4",
    "@wdio/mocha-framework": "^9.31.2",
    "@wdio/spec-reporter": "^9.31.2",
    "@wdio/tauri-plugin": "^1.3.0",
    "@wdio/tauri-service": "^1.3.0",
    "@wdio/types": "^9.31.2",
    "esbuild": "0.21.5",
    "expect-webdriverio": "^6.0.9",
    "jsdom": "^25",
    "playwright": "^1.61.1",
    "tsx": "^4.20.0",
    "typescript": "^5",
    "vite": "^5",
    "vitest": "^2"
  }
}
